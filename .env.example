# ──────────────────────────────────────────────────────────────────────
#  OmniRoute environment variables (reverse-proxy deployment)
#
#  Deploying via docker-compose.yml in Coolify? You do NOT need this file.
#  Coolify generates the secrets itself (SERVICE_* magic variables).
#
#  Use this file when deploying in Coolify as a single "Docker Image"
#  application: paste the contents into Environment Variables.
#
#  Do NOT feed it to docker-compose.yaml from this repo. That file reads
#  SERVICE_* variables from Coolify, so `docker compose --env-file .env`
#  would render every value below as empty. For a plain local run use:
#    docker run -d --name omniroute --env-file .env \
#      -p 20128:20128 -v omniroute-data:/app/data \
#      diegosouzapw/omniroute:3.8.50
#
#  Values marked REQUIRED must be set before the first start.
#  Full upstream contract (2000+ lines, every variable):
#  https://github.com/diegosouzapw/OmniRoute/blob/main/.env.example
# ──────────────────────────────────────────────────────────────────────

# ═══ 1. REQUIRED SECRETS (set before the first start) ═══

# REQUIRED. Signs dashboard session cookies (JWT).
# Generate: openssl rand -base64 48
JWT_SECRET=

# REQUIRED. HMAC secret behind the issued API key format
# sk-{machineId}-{keyId}-{crc8}. Unset means OmniRoute logs that CRC
# validation is disabled. It does not encrypt anything.
# Generate: openssl rand -hex 32
API_KEY_SECRET=

# REQUIRED in production. Authenticates the internal WebSocket bridge.
# When unset, every WS bridge request is rejected.
# Generate: openssl rand -base64 32
OMNIROUTE_WS_BRIDGE_SECRET=

# REQUIRED. Bootstrap password for the first dashboard login. Change it
# after logging in: Dashboard → Settings → Security.
# Generate: openssl rand -base64 16
INITIAL_PASSWORD=

# ═══ 2. DATABASE ENCRYPTION (optional, recommended) ═══

# Field-level AES-256-GCM encryption of stored provider credentials and
# tokens. This is not whole-database encryption: everything else in the
# SQLite file stays readable. Empty means passthrough, credentials in
# plaintext.
# Generate: openssl rand -hex 32
#
# WARNING: back this value up and do not change it. Version 3.8.50 ships no
# re-encryption path, so a new key leaves stored credentials undecryptable
# and the app only logs the mismatch.
STORAGE_ENCRYPTION_KEY=
# Recorded only. Nothing in 3.8.50 reads it, so bumping it rotates nothing.
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Salt for the machine fingerprint. Use a unique value per deployment.
# Generate: openssl rand -hex 16
MACHINE_ID_SALT=

# ═══ 3. NETWORK / REVERSE PROXY (Coolify/Traefik with TLS) ═══

# The image already sets PORT=20128 and HOSTNAME=0.0.0.0. Listed here
# because 20128 is the port the reverse proxy must forward to.
PORT=20128

# Forces the Secure flag on session cookies. OmniRoute also sets it when
# the proxy reports HTTPS, but do not lean on that. Keep true behind TLS,
# false only on plain HTTP.
AUTH_COOKIE_SECURE=true

# Public browser origin. Used for OAuth callbacks and links the UI generates.
NEXT_PUBLIC_BASE_URL=https://omniroute.yourdomain.com

# Internal self-fetch URL for scheduled jobs. Keep it loopback even behind
# a proxy. Do NOT point it at the public hostname.
BASE_URL=http://127.0.0.1:20128

# Serving under a subpath (https://host/omniroute). Root by default.
# The same subpath must also be appended to NEXT_PUBLIC_BASE_URL.
# OMNIROUTE_BASE_PATH=/omniroute

# Leave unset. Only for advanced setups where direct container access is
# blocked and the proxy sanitises forwarded headers. Setting it merely
# "because there is a Traefik" lets a spoofed header decide the origin.
# OMNIROUTE_TRUST_PROXY=true

# ═══ 4. SECURITY ═══

# Require an API key on the /v1/* proxy endpoints. Keep true on anything
# reachable from the internet. Create keys in Dashboard → API Keys.
REQUIRE_API_KEY=true

# Whether the dashboard may reveal full API key values. Keep false.
ALLOW_API_KEY_REVEAL=false

# Request body cap. Upstream's hardening checklist recommends 5 MB
# (the default is 10 MB).
MAX_BODY_SIZE_BYTES=5242880

# CORS. Not needed for the dashboard itself (same-origin). Set only when a
# separate frontend calls the API cross-origin. Never use CORS_ALLOW_ALL.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ═══ 5. STORAGE ═══

# Data directory (SQLite, logs, backups). Must be a persistent volume.
DATA_DIR=/app/data

# Automatic and pre-write SQLite backups. Keep false (backups enabled)
# unless you have verified external backups.
DISABLE_SQLITE_AUTO_BACKUP=false

# ═══ 6. REDIS (rate limiter and shared cache) ═══

# With the compose file from this repo: redis://redis:6379
# COMMENT OUT when no Redis is running, otherwise ioredis floods the logs
# with connection errors. Without Redis the app falls back to an in-memory
# rate limiter, which upstream does not recommend for production.
REDIS_URL=redis://redis:6379

# ═══ 7. RUNTIME ═══

# The image bakes NODE_ENV=production, OMNIROUTE_MEMORY_MB=1024 and
# NODE_OPTIONS=--max-old-space-size=1024. Raise the heap only in pairs:
# OMNIROUTE_MEMORY_MB=2048
# NODE_OPTIONS=--max-old-space-size=2048
#
# Driving a coding agent through /v1/responses needs far more:
# upstream measures a V8 abort near a 12 GiB heap and suggests 8192 MB
# with at least 10 GiB of RAM for a single agent session.

# TZ=Europe/Warsaw

# ═══ 8. LOGGING ═══

# APP_LOG_LEVEL=info          # debug | info | warn | error
# APP_LOG_FORMAT=text         # text | json
APP_LOG_TO_FILE=true
# APP_LOG_MAX_FILE_SIZE=50M
# APP_LOG_RETENTION_DAYS=7

# ═══ 9. PROVIDER KEYS ═══
# Preferred path: Dashboard → Providers → Add API Key. Keys added there are
# stored encrypted in the database. Env variables are an escape hatch for
# headless deployments:
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# WINDSURF_API_KEY=
